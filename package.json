{
  "name": "kosar-print-studio",
  "private": true,
  "version": "2.0.0",
  "description": "استودیو چاپ کوثر — سامانه تخصصی چیدمان، مونتاژ برداری و چاپ مستقیم PDF و تصاویر ویژه چاپخانه‌ها و کپی‌سنترها",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --port=3000 --host=0.0.0.0",
    "clean": "rm -rf dist release",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "electron:dev": "electron .",
    "electron:build": "cross-env ELECTRON_BUILD=true vite build && electron-builder --win",
    "electron:pack": "cross-env ELECTRON_BUILD=true vite build && electron-builder --dir"
  },
  "build": {
    "appId": "com.kosarprint.studio",
    "productName": "Kosar Print Studio",
    "copyright": "Copyright © 2026 Kosar Print Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/koffi/**/*",
      "**/node_modules/@koromix/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "public/icon.svg",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "استودیو چاپ کوثر (Kosar Print Studio)"
    },
    "portable": {
      "artifactName": "KosarPrintStudio-Portable-${version}.exe"
    }
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/vazirmatn": "^5.3.0",
    "koffi": "^3.3.7",
    "lucide-react": "^0.546.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "utif": "^3.1.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "@vitejs/plugin-react": "^6.1.1"
  }
}
